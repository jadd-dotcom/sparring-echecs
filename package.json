{
  "name": "sparring-echecs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && vite",
    "build": "node scripts/copy-assets.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "validate-repertoire": "sh scripts/validate-repertoire.sh",
    "verify-mates": "sh scripts/verify-mates.sh",
    "lessons-doc": "npx esbuild scripts/lessons-doc.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.lessons-doc.mjs --log-level=warning && node scripts/.lessons-doc.mjs && rm scripts/.lessons-doc.mjs",
    "board-doc": "npx esbuild scripts/board-doc.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.board-doc.mjs --log-level=warning && node scripts/.board-doc.mjs && rm scripts/.board-doc.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "chess.js": "^1.4.0",
    "dexie": "^4.4.7",
    "lucide-react": "^1.78.0",
    "maia3-js": "^0.2.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.1.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.1.0",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "license": "GPL-3.0-or-later"
}
